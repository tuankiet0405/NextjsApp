# Copy to .env.local and fill in. Never commit real values.

# Supabase (Project Settings -> API). SUPABASE_KEY = service_role key (server only!)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=

# Auth.js — generate with: npx auth secret
AUTH_SECRET=
AUTH_TRUST_HOST=true

# OAuth apps (optional — email/password login works without them)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Booking confirmation emails via Resend (optional)
RESEND_API_KEY=
EMAIL_FROM="The Wild Oasis <onboarding@resend.dev>"

NEXT_PUBLIC_SITE_URL=http://localhost:3000
